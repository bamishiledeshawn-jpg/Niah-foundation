# Copy to .env and source it, or set these in your shell / deployment platform.
# All values shown are the defaults used when the variable is unset.

PORT=8080
DB_PATH=./niah.db
ALLOWED_ORIGIN=http://localhost:5173

# REQUIRED. The server will not start without these.
# Generate a strong admin token with: openssl rand -hex 32
ADMIN_TOKEN=your-secret-token-here
PAYSTACK_SECRET_KEY=sk_test_xxxx

# Set to "true" ONLY when the server sits behind a proxy that sets
# X-Forwarded-For. It tells the rate limiter to read the client IP from that
# header; on a directly exposed server, trusting it lets callers forge the IP
# and bypass the limit.
TRUST_PROXY=false
